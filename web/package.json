{
  "name": "forensight-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint:graph": "node scripts/lint-graph.cjs http://localhost:8080/cases/$npm_config_case/graph http://localhost:8080/cases/$npm_config_case/story",
    "build:pages": "VITE_STATIC=1 vite build --base ${PAGES_BASE:-/forensight/} --outDir dist-pages && cp dist-pages/index.html dist-pages/404.html"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/newsreader": "^5.1.1",
    "@tanstack/react-query": "5.62.2",
    "cytoscape": "3.30.4",
    "cytoscape-dagre": "2.5.0",
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3",
    "vis-data": "7.1.9",
    "vis-timeline": "7.7.3",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/cytoscape": "3.21.8",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
